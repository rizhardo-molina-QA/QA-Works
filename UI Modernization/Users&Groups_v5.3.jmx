                      <stringProp name="script">def acc = vars.get(&apos;c_20CapturedClientID&apos;) ?: &apos;&apos;
def val = vars.get(&apos;pageExtract&apos;) ?: &apos;&apos;

if (val &amp;&amp; val != &apos;NOT_FOUND&apos;) {
    def delimiter = acc ? &apos;\n&apos; : &apos;&apos;
    vars.put(&apos;combined&apos;, acc + delimiter + val)
}
</stringProp>
                    </JSR223PostProcessor>
