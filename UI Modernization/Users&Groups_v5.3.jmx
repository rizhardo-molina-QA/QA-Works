          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Loop Calculator" enabled="false">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.nio.file.Files
import java.nio.file.Paths
import java.nio.charset.StandardCharsets

// Ruta del CSV (puede ser relativa o absoluta)
String csvFile = &quot;userNameID.csv&quot;

// Si tu CSV tiene encabezado, déjalo en true
boolean skipHeader = false

def path = Paths.get(csvFile)
if (!Files.exists(path)) {
    log.warn(&quot;No existe el archivo CSV: &quot; + path.toAbsolutePath())
    vars.put(&quot;l_Loops&quot;, &quot;0&quot;)
    return
}

def lines = Files.readAllLines(path, StandardCharsets.UTF_8)

// Opcional: ignorar primera fila (header)
if (skipHeader &amp;&amp; !lines.isEmpty()) {
    lines = lines.subList(1, lines.size())
}

// Contar celdas en uso (no vacías)
int usedCells = 0
lines.each { line -&gt;
    if (line != null &amp;&amp; !line.trim().isEmpty()) {
        // split simple por coma
        def cells = line.split(&quot;,&quot;, -1)
        cells.each { c -&gt;
            String cell = (c == null) ? &quot;&quot; : c.trim()
            // Limpia comillas envolventes simples para CSV básico
            if (cell.startsWith(&quot;\&quot;&quot;) &amp;&amp; cell.endsWith(&quot;\&quot;&quot;) &amp;&amp; cell.length() &gt;= 2) {
                cell = cell.substring(1, cell.length() - 1).trim()
            }
            if (!cell.isEmpty()) {
                usedCells++
            }
        }
    }
}

// Guardar en variable JMeter
vars.put(&quot;l_Loops&quot;, String.valueOf(usedCells))
log.info(&quot;Celdas en uso: &quot; + usedCells + &quot; | l_Loops=&quot; + vars.get(&quot;l_Loops&quot;))</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
