                <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">int total = (vars.get(&apos;c_GroupUserIDSelection1_matchNr&apos;) ?: &apos;0&apos;) as int
int limit = Math.min(200, total)

def sb = new StringBuilder()
//sb.append(&apos;&lt;users&gt;&apos;)
for (int i = 1; i &lt;= limit; i++) {
    def id = vars.get(&apos;c_GroupUserIDSelection1_&apos; + i)
    if (id != null) sb.append(&apos;&lt;user id=&quot;&apos;).append(id).append(&apos;&quot;/&gt;&apos;)
}
//sb.append(&apos;&lt;/users&gt;&apos;)

vars.put(&apos;c_200UserIDs&apos;, sb.toString())
vars.put(&apos;c_200UserIDs_limit&apos;, String.valueOf(limit))
</stringProp>
                </JSR223PreProcessor>
                <hashTree/>
              </hashTree>
            </hashTree>
