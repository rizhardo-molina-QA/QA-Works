            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Iteration Count" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.nio.file.Files
import java.nio.file.Paths
import java.nio.charset.StandardCharsets

// CSV path (same default used by your PostProcessor)
def defaultCsvPath = &quot;C:/Users/6112072/Downloads/apache-jmeter-5.6.3/apache-jmeter-5.6.3/bin/tagids.csv&quot;
def csvPath = vars.get(&quot;tagid_csv_path&quot;) ?: defaultCsvPath

def csvFile = Paths.get(csvPath)

if (!Files.exists(csvFile)) {
    vars.put(&quot;n_noiteration&quot;, &quot;0&quot;)
    log.warn(&quot;Sampler [count_tagids]: CSV not found at ${csvPath}. n_noiteration=0&quot;)
    return
}

int nonEmptyCells = 0

def lines = Files.readAllLines(csvFile, StandardCharsets.UTF_8)
for (String line : lines) {
    if (line == null) {
        continue
    }

    def trimmedLine = line.trim()
    if (trimmedLine.isEmpty()) {
        continue
    }

    // Counts non-empty CSV cells in each row.
    def cells = line.split(&quot;,&quot;, -1)
    for (String cell : cells) {
        if (cell != null &amp;&amp; !cell.trim().isEmpty()) {
            nonEmptyCells++
        }
    }
}

vars.put(&quot;n_noiteration&quot;, String.valueOf(nonEmptyCells))
log.info(&quot;Sampler [count_tagids]: Counted ${nonEmptyCells} non-empty cell(s) in ${csvPath}. Saved to variable n_noiteration&quot;)
println(&quot;n_noiteration=${vars.get(&apos;n_noiteration&apos;)}&quot;)
</stringProp>
            </JSR223Sampler>
