                <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import java.nio.charset.StandardCharsets
import java.nio.file.Files
import java.nio.file.Paths
import java.nio.file.StandardOpenOption

// CSV path (same default used by your PostProcessor)
def defaultCsvPath = &quot;C:/Users/6112072/Downloads/apache-jmeter-5.6.3/apache-jmeter-5.6.3/bin/tagids.csv&quot;
def csvPath = vars.get(&quot;tagid_csv_path&quot;) ?: defaultCsvPath

def csvFile = Paths.get(csvPath)
if (!Files.exists(csvFile)) {
    vars.put(&quot;t_tagIds&quot;, &quot;&quot;)
    log.warn(&quot;PreProcessor [iterate_tagids]: CSV not found at ${csvPath}. t_tagIds empty.&quot;)
    println(&quot;t_tagIds=&quot;)
    return
}

// Consume values as a queue: use first value, then remove it from CSV.
// Synchronize to avoid read/write races when multiple JMeter threads run this preprocessor.
synchronized (props) {
    def values = []
    Files.readAllLines(csvFile, StandardCharsets.UTF_8).each { line -&gt;
        if (line == null || line.trim().isEmpty()) {
            return
        }

        line.split(&quot;,&quot;, -1).each { cell -&gt;
            def value = cell?.trim()
            if (value) {
                values &lt;&lt; value
            }
        }
    }

    if (values.isEmpty()) {
        vars.put(&quot;t_tagIds&quot;, &quot;&quot;)
        log.warn(&quot;PreProcessor [iterate_tagids]: CSV has no non-empty values. t_tagIds empty.&quot;)
        println(&quot;t_tagIds=&quot;)
        return
    }

    def currentTagId = values.remove(0)
    vars.put(&quot;t_tagIds&quot;, currentTagId)

    def remainingContent = values.collect { it + System.lineSeparator() }.join(&quot;&quot;)
    Files.write(
        csvFile,
        remainingContent.getBytes(&quot;UTF-8&quot;),
        StandardOpenOption.CREATE,
        StandardOpenOption.TRUNCATE_EXISTING,
        StandardOpenOption.WRITE
    )

    log.info(&quot;PreProcessor [iterate_tagids]: t_tagIds=${currentTagId}, remaining values=${values.size()}&quot;)
    println(&quot;t_tagIds=${currentTagId}&quot;)
}
</stringProp>
                </JSR223PreProcessor>
