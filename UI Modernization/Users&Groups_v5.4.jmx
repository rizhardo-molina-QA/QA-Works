                  <stringProp name="script">log.info(&quot;g_tag = &quot; + vars.get(&quot;g_tag&quot;))
log.info(&quot;g_tagID = &quot; + vars.get(&quot;g_tagID&quot;))</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                </JSR223PostProcessor>
