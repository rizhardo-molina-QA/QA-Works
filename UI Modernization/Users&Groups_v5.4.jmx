            <stringProp name="script">def filePath = &quot;userNameID.csv&quot;
def file = new File(filePath)

if (file.exists()) {
    file.withWriter(&apos;UTF-8&apos;) { writer -&gt;
        writer.write(&quot;&quot;)
    }
    log.info(&quot;CSV limpiado correctamente: &quot; + file.absolutePath)
    SampleResult.setResponseData(&quot;CSV limpiado: &quot; + file.absolutePath, &quot;UTF-8&quot;)
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
} else {
    log.warn(&quot;Archivo no encontrado: &quot; + file.absolutePath)
    SampleResult.setResponseData(&quot;No encontrado: &quot; + file.absolutePath, &quot;UTF-8&quot;)
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
}</stringProp>
