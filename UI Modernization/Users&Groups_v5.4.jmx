              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
import java.nio.file.Files
import java.nio.file.Paths
import java.nio.file.StandardOpenOption
import org.apache.jmeter.services.FileServer

// Configuration
// Path where the CSV will be written. You can override this with a JMeter
// variable: ${__P(tagid.csv.path,C:/JMeter/output/tagids.csv)}
def defaultCsvPath = &quot;C:/Users/6112072/Downloads/apache-jmeter-5.6.3/apache-jmeter-5.6.3/bin/tagids.csv&quot;
def csvPath = vars.get(&quot;tagid_csv_path&quot;) ?: defaultCsvPath

// Prefix to match against tagName (wildcard = anything after this string)
def tagNamePrefix = &quot;PerformanceQED&quot;

def tagNameRegex = ~(&quot;^&quot; + java.util.regex.Pattern.quote(tagNamePrefix) + &quot;.*&quot;)

def getValueIgnoreCase = { Map item, List&lt;String&gt; keys -&gt;
    if (!item) {
        return null
    }

    for (String key : keys) {
        if (item.containsKey(key)) {
            return item[key]
        }
    }

    for (entry in item.entrySet()) {
        def entryKey = String.valueOf(entry.key)
        if (keys.any { it.equalsIgnoreCase(entryKey) }) {
            return entry.value
        }
    }

    return null
}

def responseBody = prev.getResponseDataAsString()

if (!responseBody?.trim()) {
    log.warn(&quot;PostProcessor [tagid_csv]: Response body is empty, skipping.&quot;)
    return
}

def json
try {
    json = new JsonSlurper().parseText(responseBody)
} catch (Exception e) {
    log.error(&quot;PostProcessor [tagid_csv]: Failed to parse JSON response - ${e.message}&quot;)
    return
}

def tags = json?.tags
if (!tags) {
    // Fallback: search for tags/TAGS in a case-insensitive way at root level
    if (json instanceof Map) {
        tags = getValueIgnoreCase(json as Map, [&quot;tags&quot;, &quot;TAGS&quot;])
    }
}

if (!(tags instanceof List) || tags.isEmpty()) {
    log.warn(&quot;PostProcessor [tagid_csv]: No valid &apos;tags&apos; array found in response.&quot;)
    return
}

// Filter tags whose tagName matches PerformanceQED* (case-insensitive)
def matchingIds = tags
    .findAll { item -&gt;
        if (!(item instanceof Map)) {
            return false
        }
        def tagName = getValueIgnoreCase(item as Map, [&quot;tagName&quot;, &quot;TAGNAME&quot;])
        return String.valueOf(tagName ?: &quot;&quot;).trim() ==~ /(?i)${tagNameRegex.pattern()}/
    }
    .collect { item -&gt;
        def tagId = getValueIgnoreCase(item as Map, [&quot;tagId&quot;, &quot;TAGID&quot;])
        return String.valueOf(tagId ?: &quot;&quot;).trim()
    }
    .findAll { it }   // remove nulls / blank entries

if (matchingIds.isEmpty()) {
    log.info(&quot;PostProcessor [tagid_csv]: No tags matching &apos;${tagNamePrefix}*&apos; found. Total tags read: ${tags.size()}&quot;)
    return
}

// Ensure parent directories exist
def file = new File(csvPath)
file.parentFile?.mkdirs()

// Append each tagId as a new line (creates the file if it does not exist)
def lines = matchingIds.collect { it + System.lineSeparator() }.join(&quot;&quot;)

try {
    Files.write(
        Paths.get(csvPath),
        lines.getBytes(&quot;UTF-8&quot;),
        StandardOpenOption.CREATE,
        StandardOpenOption.APPEND
    )
} catch (Exception e) {
    log.error(&quot;PostProcessor [tagid_csv]: Failed writing CSV at ${csvPath} - ${e.message}&quot;)
    return
}

log.info(&quot;PostProcessor [tagid_csv]: Wrote ${matchingIds.size()} tagId(s) to ${csvPath}&quot;)
log.info(&quot;PostProcessor [tagid_csv]: IDs written -&gt; ${matchingIds}&quot;)
</stringProp>
              </JSR223PostProcessor>
