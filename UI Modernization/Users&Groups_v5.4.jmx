                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import java.security.SecureRandom

// 1) Identificar la variable u_LoginCreate (leer valor actual)
def currentGName = vars.get(&quot;g_name&quot;)
println(&quot;Valor actual de g_name: ${currentGName}&quot;)

// 2) Generar cadena alfanumérica de 10 caracteres, con &quot;Per&quot; al inicio
def random = new SecureRandom()
def chars = ((&apos;A&apos;..&apos;Z&apos;) + (&apos;a&apos;..&apos;z&apos;) + (&apos;0&apos;..&apos;9&apos;))
def suffix = (1..10).collect { chars[random.nextInt(chars.size())] }.join()
def generatedValue = &quot;Performance${suffix}group&quot;   // 3 + 7 = 10

// 3) Guardar el valor generado en la variable g_name
vars.put(&quot;g_name&quot;, generatedValue)

// Verificar que se guardó correctamente y cumple formato
def savedValue = vars.get(&quot;g_name&quot;)
def isValid = savedValue != null &amp;&amp;
              savedValue.length() == 10 &amp;&amp;
              (savedValue ==~ /^Per[A-Za-z0-9]{7}$/)

// 4 y 5) Mensajes de validación
if (isValid) {
    println(&quot;work is done y el valor guardado en la variable: ${savedValue}&quot;)
} else {
    println(&quot;El valor no fue generado correctamente&quot;)
}</stringProp>
                </JSR223PreProcessor>
                <hashTree/>
                <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="g_ID" enabled="true">
                  <stringProp name="RegexExtractor.useHeaders">false</stringProp>
                  <stringProp name="RegexExtractor.refname">g_ID</stringProp>
                  <stringProp name="RegexExtractor.regex">&quot;groupId&quot;:&quot;(.*?)&quot;,</stringProp>
                  <stringProp name="RegexExtractor.template">$1$</stringProp>
                  <stringProp name="RegexExtractor.default">g_Group ID_NOTFOUND</stringProp>
                  <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
                  <stringProp name="RegexExtractor.match_number">1</stringProp>
                </RegexExtractor>
