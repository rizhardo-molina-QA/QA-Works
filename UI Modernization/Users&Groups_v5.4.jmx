                <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Group tag PreProcessor" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">// Get the current value of g_name  
def g_tag = vars.get(&quot;g_tag&quot;)

// Use regex to split the prefix and the number at the end  
def matcher = (g_tag =~ /^(.*?)(\d+)$/)  
if (matcher.matches()) {  
    def prefix = matcher[0][1]  
    def numberStr = matcher[0][2]

    if (numberStr == &quot;01&quot;) {  
        // If ending with 01, generate a random number between 1000 and 2000  
        def randNum = (10000 + (Math.random() * 100000)).toInteger()  
        vars.put(&quot;g_tag&quot;, prefix + randNum)  
    } else {  
        // Otherwise, increment the number  
        def number = numberStr.toInteger() + 1  
        // Preserve leading zeros (if any)  
        def newNumberStr = String.format(&quot;%0${numberStr.length()}d&quot;, number)  
        vars.put(&quot;g_tag&quot;, prefix + newNumberStr)  
    }  
} else {  
    // If not matching expected pattern, do nothing or log an error  
    log.warn(&quot;g_tag variable does not match expected pattern: &quot; + g_name)  
}  </stringProp>
                </JSR223PreProcessor>
