                <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="User login name PreProcessorV2" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import java.security.SecureRandom

// 1) Identificar la variable u_LoginCreate (leer valor actual)
def currentGName = vars.get(&quot;u_LoginCreate&quot;)
println(&quot;Valor actual de u_LoginCreate: ${currentGName}&quot;)

// 2) Generar cadena alfanumérica de 10 caracteres, con &quot;Per&quot; al inicio
def random = new SecureRandom()
def chars = ((&apos;A&apos;..&apos;Z&apos;) + (&apos;a&apos;..&apos;z&apos;) + (&apos;0&apos;..&apos;9&apos;))
def suffix = (1..10).collect { chars[random.nextInt(chars.size())] }.join()
def generatedValue = &quot;Performance${suffix}@tr.com&quot;   // 3 + 7 = 10

// 3) Guardar el valor generado en la variable g_name
vars.put(&quot;u_LoginCreate&quot;, generatedValue)

// Verificar que se guardó correctamente y cumple formato
def savedValue = vars.get(&quot;u_LoginCreate&quot;)
def isValid = savedValue != null &amp;&amp;
              savedValue.length() == 10 &amp;&amp;
              (savedValue ==~ /^Per[A-Za-z0-9]{7}$/)

// 4 y 5) Mensajes de validación
if (isValid) {
    println(&quot;work is done y el valor guardado en la variable: ${savedValue}&quot;)
} else {
    println(&quot;El valor no fue generado correctamente&quot;)
}</stringProp>
                </JSR223PreProcessor>
                <hashTree/>
                <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="n_UserIDnew" enabled="true">
                  <stringProp name="RegexExtractor.useHeaders">false</stringProp>
                  <stringProp name="RegexExtractor.refname">n_UserIDnew</stringProp>
                  <stringProp name="RegexExtractor.regex">&quot;userId&quot;:&quot;(.*?)&quot;,</stringProp>
                  <stringProp name="RegexExtractor.template">$1$</stringProp>
                  <stringProp name="RegexExtractor.default">c_UserID1_NOTFOUND</stringProp>
                  <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
                  <stringProp name="RegexExtractor.match_number">1</stringProp>
                </RegexExtractor>
                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">def u_LoginCreate = vars.get(&quot;u_LoginCreate&quot;)

if (u_LoginCreate != null &amp;&amp; u_LoginCreate != &quot;u_LoginCreate_NOTFOUND&quot;) {
    // Define the file path
    def filePath = &quot;userNameID.csv&quot;
    def file = new File(filePath)

    // Read the file content
    def fileLines = file.exists() ? file.readLines() : []

    // Verify if the first cell is empty
    if (fileLines.isEmpty() || fileLines[0].trim().isEmpty()) {
        // Write on the first cell
        file.withWriter(&apos;UTF-8&apos;) { writer -&gt;
            writer.writeLine(u_LoginCreate.trim())
        }
        log.info(&quot;Written u_LoginCreate on the first cell.&quot;)
    } else {
        // Write on the next available row
        file.withWriterAppend(&apos;UTF-8&apos;) { writer -&gt;
            writer.writeLine(u_LoginCreate.trim())
        }
        log.info(&quot;Written u_LoginCreate on the next available row&quot;)
    }
} else {
    log.info(&quot;No action taken - u_LoginCreate is empty.&quot;)
}</stringProp>
                </JSR223PostProcessor>
