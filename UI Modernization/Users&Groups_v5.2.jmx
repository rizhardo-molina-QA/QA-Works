                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import java.net.URLEncoder
import java.nio.charset.StandardCharsets;
 
String str = vars.get(&quot;USERNAME&quot;)
try {

    String encodedUsername = URLEncoder.encode(str, StandardCharsets.UTF_8.toString())

    vars.put(&quot;p_encodedUsername&quot;, encodedUsername)

} catch (Exception e) {

    log.error(&quot;Encoding failed&quot;, e)

}

 </stringProp>
              </JSR223PreProcessor>
