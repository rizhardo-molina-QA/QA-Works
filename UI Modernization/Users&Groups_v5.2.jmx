        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="Clear File - JSR223 Sampler" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Clear File - JSR223 Sampler" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def filePath = &quot;userNameID.csv&quot;
def file = new File(filePath)

if (file.exists()) {
    file.withWriter(&apos;UTF-8&apos;) { writer -&gt;
        writer.write(&quot;&quot;)
    }
    log.info(&quot;CSV limpiado correctamente: &quot; + file.absolutePath)
    SampleResult.setResponseData(&quot;CSV limpiado: &quot; + file.absolutePath, &quot;UTF-8&quot;)
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
} else {
    log.warn(&quot;Archivo no encontrado: &quot; + file.absolutePath)
    SampleResult.setResponseData(&quot;No encontrado: &quot; + file.absolutePath, &quot;UTF-8&quot;)
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
      </hashTree>
