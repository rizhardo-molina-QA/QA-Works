                    <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
                      <stringProp name="scriptLanguage">groovy</stringProp>
                      <stringProp name="parameters"></stringProp>
                      <stringProp name="filename"></stringProp>
                      <stringProp name="cacheKey">true</stringProp>
                      <stringProp name="script">int total = (vars.get(&apos;c_CapturedClientID1_matchNr&apos;) ?: &apos;0&apos;) as int
int limit = Math.min(20, total)

def sb = new StringBuilder()
for (int i = 1; i &lt;= limit; i++) {
    def id = vars.get(&apos;c_CapturedClientID1_&apos; + i)
    if (id != null) sb.append(&apos;&lt;dss&gt;&lt;![CDATA[&apos;).append(id).append(&apos;]]&gt;&lt;/dss&gt;&apos;)
}

def currentChunk = sb.toString()

// keep per-iteration var if you still need it
vars.put(&apos;c_20CapturedClientID&apos;, currentChunk)
vars.put(&apos;c_20CapturedClientID_limit&apos;, String.valueOf(limit))

// append into the accumulator
def combined = (vars.get(&apos;c_AllCapturedClientID&apos;) ?: &apos;&apos;) + currentChunk
vars.put(&apos;c_AllCapturedClientID&apos;, combined)

log.info(&quot;Chunk length=&quot; + currentChunk.length() + &quot;, combined length=&quot; + combined.length())
</stringProp>
                    </JSR223PostProcessor>
